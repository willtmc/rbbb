{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willtmc/rbbb/specification/commands/reduce-maximum.schema.json",
  "title": "Reduce maximum command",
  "description": "Withdraw only the unexecuted portion of one bidder's private maximum.",
  "x-rbbb-status": "experimental",
  "allOf": [
    {"$ref": "./base.schema.json"},
    {
      "type": "object",
      "required": ["bidder_id", "maximum_minor_units"],
      "properties": {
        "type": {"const": "reduce_maximum"},
        "bidder_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "maximum_minor_units": {"$ref": "../common/money.schema.json#/$defs/minorUnits"}
      }
    }
  ],
  "unevaluatedProperties": false
}
