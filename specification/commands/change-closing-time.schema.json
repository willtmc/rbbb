{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willtmc/rbbb/specification/commands/change-closing-time.schema.json",
  "title": "Change closing time command",
  "description": "Move or extend closing time within RFC 0001 constraints.",
  "x-rbbb-status": "experimental",
  "allOf": [
    {"$ref": "./base.schema.json"},
    {
      "type": "object",
      "required": ["operator_id", "reason", "closes_at"],
      "properties": {
        "type": {"const": "change_closing_time"},
        "operator_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "closes_at": {"$ref": "../common/timestamp.schema.json"}
      }
    }
  ],
  "unevaluatedProperties": false
}
