{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willtmc/rbbb/specification/state/bidding-unit.schema.json",
  "title": "Public bidding unit state",
  "description": "Public RFC 0001 query projection. It excludes bidder identity, private maxima, reserve amount, and operator audit facts.",
  "x-rbbb-status": "experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auction_id",
    "bidding_unit_id",
    "version",
    "status",
    "currency",
    "opens_at",
    "closes_at",
    "standing_minor_units",
    "next_required_minor_units",
    "reserve_status",
    "result",
    "winning_minor_units"
  ],
  "properties": {
    "auction_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "bidding_unit_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "version": {"$ref": "../common/integer.schema.json#/$defs/nonNegativeInteger"},
    "status": {"type": "string", "enum": ["open", "closed"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "opens_at": {"$ref": "../common/timestamp.schema.json"},
    "closes_at": {"$ref": "../common/timestamp.schema.json"},
    "standing_minor_units": {"$ref": "../common/money.schema.json#/$defs/optionalMinorUnits"},
    "next_required_minor_units": {"$ref": "../common/money.schema.json#/$defs/minorUnits"},
    "reserve_status": {
      "type": ["string", "null"],
      "enum": ["reserve_not_met", "reserve_met", null]
    },
    "result": {
      "type": ["string", "null"],
      "enum": ["sold", "no_sale", "no_bid", null]
    },
    "winning_minor_units": {"$ref": "../common/money.schema.json#/$defs/optionalMinorUnits"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "open"}}},
      "then": {
        "properties": {
          "result": {"const": null},
          "winning_minor_units": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "sold"}}},
      "then": {
        "properties": {
          "winning_minor_units": {"$ref": "../common/money.schema.json#/$defs/minorUnits"}
        }
      }
    },
    {
      "if": {"properties": {"result": {"enum": ["no_sale", "no_bid"]}}},
      "then": {"properties": {"winning_minor_units": {"const": null}}}
    },
    {
      "if": {"properties": {"result": {"const": "no_bid"}}},
      "then": {"properties": {"standing_minor_units": {"const": null}}}
    }
  ]
}
