{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/willtmc/rbbb/conformance/schemas/scenario.schema.json",
  "title": "RBBB conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "specification_version",
    "rfcs",
    "configuration",
    "starting_state",
    "commands",
    "expected"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "specification_version": {"type": "string", "minLength": 1},
    "rfcs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9]{4}$"}
    },
    "configuration": {"type": "object"},
    "starting_state": {"type": "object"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_events", "final_state"],
      "properties": {
        "public_events": {"type": "array", "items": {"type": "object"}},
        "privileged_events": {"type": "array", "items": {"type": "object"}},
        "rejections": {"type": "array", "items": {"type": "object"}},
        "final_state": {"type": "object"}
      }
    }
  }
}
